# Skopiuj ten plik jako .env i uzupełnij wartości (lokalny development).
# NA VERCEL: ustaw te same zmienne w Dashboard → Settings → Environment Variables.

# Wymagane (wygeneruj np. przez: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=twoj-tajny-klucz

# Lokalnie: True. Na Vercel: False.
DJANGO_DEBUG=True

# Lokalnie: localhost,127.0.0.1. Na Vercel: twoja-domena.vercel.app,admin.twoja-domena.vercel.app
# (lub '.vercel.app' żeby objąć wszystkie subdomeny — patrz settings.py)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- BAZA DANYCH (CMS) ---
# Lokalnie: puste = SQLite (domyślnie). Na Vercel: Postgres.
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DB

# --- SUPERUSER PANELU ADMINA (tworzony automatycznie przy starcie na Vercel) ---
DJANGO_SUPERUSER_EMAIL=m.dziubek@mbt.pl
DJANGO_SUPERUSER_PASSWORD=Twoje-Tajne-Haslo
