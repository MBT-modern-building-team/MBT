msgstr "Опишіть свій проект..."

msgid ""
"Optymalne rozwiązania inżynieryjne, precyzyjny harmonogram i transparentny "
"budżet."
msgstr ""
"Optimal engineering solutions, a precise schedule and a transparent budget."

msgid "Polityka <strong>prywatności</strong>"
msgstr "Політика <strong>конфіденційності</strong>"

msgid "Pon-Pt:"
msgstr "Пн-Пт:"

msgid "Porozmawiaj z nami"
msgstr "Поговоріть з нами"

msgid "Porozmawiajmy — dobierzemy optymalną formułę dla Twojego projektu."
msgstr ""
"Давайте поговоримо — ми підберемо оптимальну формулу для вашого проекту."

msgid "Portfolio"
msgstr "Портфоліо"

msgid "Poznaj nas <strong>bliżej</strong>"
msgstr "Пізнайте нас <strong>ближче</strong>"

msgid "Poznaj nasz zespół"
msgstr "Познайомтеся з нашою командою"

msgid ""
"Prace fundamentowe, wznoszenie konstrukcji, montaż instalacji i wykończenie."
msgstr ""
"Фундаментні роботи, зведення конструкцій, монтаж інсталяцій та оздоблення."

msgid "Projektowanie"
msgstr "Проектування"

msgid "Projektowanie i Kosztorys"
msgstr "Проектування та Кошторис"

msgid "Przestrzenie biurowe"
msgstr "Офісні приміщення"

msgid "Przydatne linki"
msgstr "Корисні посилання"

